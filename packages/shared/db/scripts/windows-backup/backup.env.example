# FinTracker Windows backup - configuration.
#
# Copy this file to `backup.env` in the same folder and fill in DATABASE_URL.
# backup.env is gitignored. Setup moves it into BACKUP_DIR, which only SYSTEM
# and Administrators can read, so the password doesn't stay in your checkout.

# Neon connection string - the same value as DATABASE_URL in
# packages/apps/fintracker/.env.local. Use the direct host (not "-pooler").
DATABASE_URL=

# Where the .dump files, the log and the installed copy of this setup live.
BACKUP_DIR=C:\Backups\fintracker

# Backups older than this many days are deleted after each successful run.
KEEP_DAYS=60

# Daily run time (24h). A missed run happens as soon as the PC is back on.
DAILY_AT=21:00
